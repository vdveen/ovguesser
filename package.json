{
  "name": "ovguesser",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "data": "node --experimental-strip-types scripts/build-data.ts",
    "dev": "vite",
    "dev:server": "node --experimental-strip-types --watch server/main.ts",
    "build": "npm run data && tsc --noEmit && vite build && node scripts/build-server.mjs && node scripts/precompress.mjs",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run data"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "idb": "^8.0.3",
    "maplibre-gl": "^6.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
